---
// Override SiteTitle: tambahkan badge versi paket di samping judul situs.
// Pada desktop: Logo + Nama Situs + Versi Packagist.
// Pada mobile: HANYA TAMPILKAN LOGO SAJA di header untuk estetika responsif yang bersih.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import pkg from '../data/package.json';

const version = pkg.packagist?.version ?? pkg.version;
---

<Default />

<a
	class="pkg-version"
	href={pkg.packagist.url}
	target="_blank"
	rel="noopener"
	title={`Versi terbaru paket di Packagist: v${version}`}
>
	v{version}
</a>

<style>
	:global(.title-wrapper) {
		gap: 0.75rem;
		align-items: center;
	}

	:global(.site-title) {
		font-family: var(--sl-font) !important;
		font-weight: 700 !important;
		letter-spacing: -0.02em !important;
		transition: opacity 0.15s ease;
	}

	.pkg-version {
		align-self: center;
		flex: none;
		display: inline-flex;
		align-items: center;
		margin-inline-start: 0.75rem;
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		line-height: 1.4;
		color: var(--sl-color-text-accent);
		background-color: var(--sl-color-gray-6);
		text-decoration: none;
		white-space: nowrap;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	.pkg-version:hover {
		border-color: var(--sl-color-accent);
		background-color: var(--sl-color-accent-low);
	}

	/* Tampilan Responsif Mobile: Header hanya menampilkan Logo saja */
	@media (max-width: 50rem) {
		:global(.site-title span) {
			display: none !important;
		}

		:global(.site-title img) {
			height: 2.25rem !important;
			width: auto !important;
			max-height: 100% !important;
			display: block !important;
			object-fit: contain !important;
		}

		:global(.title-wrapper) {
			gap: 0 !important;
			padding: 0 !important;
			margin: 0 !important;
		}

		.pkg-version {
			display: none !important;
		}
	}
</style>
